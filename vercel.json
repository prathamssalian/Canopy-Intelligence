{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{templates/**,best.onnx}",
      "excludeFiles": "{dataset/**,dataset_aug/**,dataset_bal/**,a/**,runs/**,notebooks/**,scripts/**,*.pt}"
    }
  },
  "rewrites": [
    {
      "source": "/drone",
      "destination": "/api/index?path=/drone"
    },
    {
      "source": "/user",
      "destination": "/api/index?path=/user"
    },
    {
      "source": "/user/latest",
      "destination": "/api/index?path=/user/latest"
    },
    {
      "source": "/drone/publish",
      "destination": "/api/index?path=/drone/publish"
    },
    {
      "source": "/user/analyse",
      "destination": "/api/index?path=/user/analyse"
    },
    {
      "source": "/camera-detect",
      "destination": "/api/index?path=/camera-detect"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index?path=/$1"
    }
  ]
}